PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas (Cloud Database) ────────────────────────────────
# Get this from: https://cloud.mongodb.com → Create Free Cluster → Connect
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/farmconnect_v2?retryWrites=true&w=majority

# ─── JWT Secret ─────────────────────────────────────────────────────
JWT_SECRET=farmconnect_super_secret_key_change_this_in_production_2026

# ─── CORS: Your Vercel frontend URL ─────────────────────────────────
# Set this to your actual Vercel deployment URL (no trailing slash)
ALLOWED_ORIGINS=https://farmconnect.vercel.app,https://your-app.vercel.app

# ─── Email Notifications (Optional) ─────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=FarmConnect <no-reply@farmconnect.com>

# ─── Payment Gateway ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── API Keys (Optional) ─────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_key
WEATHER_API_KEY=your_openweathermap_key
GOOGLE_MAPS_API_KEY=your_google_maps_key
