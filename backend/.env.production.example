# ─────────────────────────────────────────────────────────────────
# FarmConnect Backend – Production Environment Variables Example
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.
# NEVER commit your actual .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (MongoDB Atlas) ─────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/farmconnect_v2?retryWrites=true&w=majority

# ── Authentication ───────────────────────────────────────────────
# Use a strong random string (min 64 chars) in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_64char_secret_key_never_use_default

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://farmconnect.vercel.app,https://www.farmconnect.in

# ── Email OTP & Notifications (choose ONE provider) ───────────────
# Resend: create an API key and verify your sending domain at resend.com.
# SendGrid: create an API key and verify sender/domain in SendGrid.
# SMTP/Gmail: enable 2FA and create a Google App Password (not your login password).
# EMAIL_FROM must use a sender/domain verified by the selected provider.
# Recommended: Resend SMTP
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM="FarmConnect Security <no-reply@your-verified-domain.com>"

# Alternative: SendGrid SMTP (remove RESEND_API_KEY when using this)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx

# Alternative: generic SMTP / Gmail App Password (remove provider API keys)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_16_char_app_password
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587

# ── External APIs (Phase 4 Features) ────────────────────────────
# OpenWeatherMap: https://openweathermap.org/api → Free tier available
WEATHER_API_KEY=your_openweathermap_api_key

# Google Maps: https://console.cloud.google.com → Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
