# Frontend Production Environment
# Used when building for Vercel / production deployment.
# The VITE_ prefix exposes this variable to client-side code.

# ── API Base URL ─────────────────────────────────────────────────
# Point to your deployed backend on Render/Railway.
# Leave as /api for local dev (Vite proxy handles it).
VITE_API_URL=https://farmconnect-api.onrender.com/api

# ── App Config ───────────────────────────────────────────────────
VITE_APP_NAME=FarmConnect
VITE_APP_VERSION=5.0.0
